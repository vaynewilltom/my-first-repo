{
  "name": "usdt-bridge-monitor",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "start": "concurrently \"webpack\" \"tsc -p tsconfig.main.json\" \"electron .\"",
    "build": "webpack && tsc -p tsconfig.main.json && electron-builder build --win portable",
    "watch": "concurrently \"webpack --watch\" \"tsc -p tsconfig.main.json --watch\"",
    "dev": "webpack serve --hot"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "puppeteer": "^21.5.0"
  },
  "devDependencies": {
    "@types/puppeteer": "^7.0.4",
    "@babel/core": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/electron": "^1.6.10",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "typescript": "^5.0.0",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
