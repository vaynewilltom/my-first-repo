# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database Configuration
DB_PATH=/opt/crypto_market_bot/data/market_data.db

# Scraping Configuration
SCRAPE_INTERVAL=300  # 5 minutes in seconds
CACHE_SIZE=20  # Number of top cryptocurrencies to cache
DISPLAY_SIZE=10  # Number of cryptocurrencies to display in /gettop10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/crypto_market_bot/bot.log

# Chart Configuration
CHART_HISTORY_HOURS=24
CHART_UPDATE_INTERVAL=300  # 5 minutes in seconds
