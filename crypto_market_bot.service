[Unit]
Description=Crypto Market Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/repos/my-first-repo
Environment=PYTHONPATH=/home/ubuntu/repos/my-first-repo
ExecStartPre=/bin/mkdir -p /var/log/crypto_market_bot
ExecStartPre=/bin/chown -R ubuntu:ubuntu /var/log/crypto_market_bot
ExecStart=/usr/bin/python3 src/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
